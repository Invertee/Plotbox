        "combined_file": {
          "default": true,
          "title": "Combined File",
          "type": "boolean"
        },
        "dry_run": {
          "default": true,
          "title": "Dry Run",
          "type": "boolean"
        },
        "page_boundary": {
          "default": true,
          "title": "Page Boundary",
          "type": "boolean"
        },
        "profile_id": {
          "default": "fluidnc-z-axis-a3",
          "title": "Profile Id",
          "type": "string"
        },
        "separate_pass_files": {
          "default": true,
          "title": "Separate Pass Files",
          "type": "boolean"
        }
      },
      "title": "ExportSelection",
      "type": "object"
    },
    "GeometrySettings": {
      "additionalProperties": false,
      "properties": {
        "curve_tolerance_mm": {
          "default": 0.05,
          "exclusiveMinimum": 0,
          "title": "Curve Tolerance Mm",
          "type": "number"
        },
        "endpoint_snap_tolerance_mm": {
          "default": 0.05,
          "minimum": 0,
          "title": "Endpoint Snap Tolerance Mm",
          "type": "number"
        },
        "minimum_path_length_mm": {
          "default": 0.2,
          "minimum": 0,
          "title": "Minimum Path Length Mm",
          "type": "number"
        },
        "ordering_quality": {
          "default": "standard",
          "enum": [
            "draft",
            "standard"
          ],
          "title": "Ordering Quality",
          "type": "string"
        },
        "simplification_tolerance_mm": {
          "default": 0.02,
          "minimum": 0,
          "title": "Simplification Tolerance Mm",
          "type": "number"
        }
      },
      "title": "GeometrySettings",
      "type": "object"
    },
    "ModeParameterValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "type": "number"
          },
          "type": "array"
        }
      ]
    },
    "ModeSettings": {
      "additionalProperties": false,
      "properties": {
        "mode_id": {
          "default": "builtin.test-pattern",
          "title": "Mode Id",
          "type": "string"
        },
        "parameter_schema_version": {
          "default": 1,
          "minimum": 1,
          "title": "Parameter Schema Version",
          "type": "integer"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/ModeParameterValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "quality": {
          "default": "export",
          "enum": [
            "draft",
            "standard",
            "export"
          ],
          "title": "Quality",
          "type": "string"
        },
        "seed": {
          "default": "codex-vertical-slice-1",
          "title": "Seed",
          "type": "string"
        },
        "version": {
          "default": "1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "title": "ModeSettings",
      "type": "object"
    },
    "NormalizedCrop": {
      "additionalProperties": false,
      "description": "Source crop in normalized image coordinates with a top-left origin.",
      "properties": {
        "height": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Height",
          "type": "number"
        },
        "width": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "default": 0.0,
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0.0,
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "title": "NormalizedCrop",
      "type": "object"
    },
    "OsmBounds": {
      "additionalProperties": false,
      "properties": {
        "east": {
          "maximum": 180,
          "minimum": -180,
          "title": "East",
          "type": "number"
        },
        "north": {
          "maximum": 85,
          "minimum": -85,
          "title": "North",
          "type": "number"
        },
        "south": {
          "maximum": 85,
          "minimum": -85,
          "title": "South",
          "type": "number"
        },
        "west": {
          "maximum": 180,
          "minimum": -180,
          "title": "West",
          "type": "number"
        }
      },
      "required": [
        "south",
        "west",
        "north",
        "east"
      ],
      "title": "OsmBounds",
      "type": "object"
    },
    "OsmFeatureToggles": {
      "additionalProperties": false,
      "properties": {
        "buildings": {
          "default": true,
          "title": "Buildings",
          "type": "boolean"
        },
        "parks": {
          "default": true,
          "title": "Parks",
          "type": "boolean"
        },
        "rail": {
          "default": true,
          "title": "Rail",
          "type": "boolean"
        },
        "roads": {
          "default": true,
          "title": "Roads",
          "type": "boolean"
        },
        "water": {
          "default": true,
          "title": "Water",
          "type": "boolean"
        }
      },
      "title": "OsmFeatureToggles",
      "type": "object"
    },
    "OsmRenderRules": {
      "additionalProperties": false,
      "properties": {
        "building_treatment": {
          "default": "outline",
          "enum": [
            "outline",
            "hatch"
          ],
          "title": "Building Treatment",
          "type": "string"
        },
        "minimum_feature_mm": {
          "default": 0.3,
          "maximum": 20,
          "minimum": 0,
          "title": "Minimum Feature Mm",
          "type": "number"
        },
        "park_treatment": {
          "default": "outline",
          "enum": [
            "outline",
            "hatch"
          ],
          "title": "Park Treatment",
          "type": "string"
        },
        "polygon_hatch_angle_degrees": {
          "default": 45,
          "maximum": 360,
          "minimum": -360,
          "title": "Polygon Hatch Angle Degrees",
          "type": "number"
        },
        "polygon_hatch_spacing_mm": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "maximum": 30,
          "title": "Polygon Hatch Spacing Mm",
          "type": "number"
        },
        "road_line_treatment": {
          "default": "centerline",
          "enum": [
            "centerline",
            "casing",
            "parallel"
          ],
          "title": "Road Line Treatment",
          "type": "string"
        },
        "road_width_mm": {
          "default": 0.8,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Road Width Mm",
          "type": "number"
        },
        "simplification_tolerance_mm": {
          "default": 0.08,
          "maximum": 10,
          "minimum": 0,
          "title": "Simplification Tolerance Mm",
          "type": "number"
        },
        "water_treatment": {
          "default": "hatch",
          "enum": [
            "outline",
            "hatch"
          ],
          "title": "Water Treatment",
          "type": "string"
        }
      },
      "title": "OsmRenderRules",
      "type": "object"
    },
    "OsmSelection": {
      "additionalProperties": false,
      "properties": {
        "bounds": {
          "$ref": "#/$defs/OsmBounds"
        },
        "lock_mode": {
          "default": "extent",
          "enum": [
            "extent",
            "scale"
          ],
          "title": "Lock Mode",
          "type": "string"
        },
        "rotation_degrees": {
          "default": 0,
          "maximum": 180,
          "minimum": -180,
          "title": "Rotation Degrees",
          "type": "number"
        }
      },
      "title": "OsmSelection",
      "type": "object"
    },
    "OsmSettings": {
      "additionalProperties": false,
      "properties": {
        "features": {
          "$ref": "#/$defs/OsmFeatureToggles"
        },
        "render": {
          "$ref": "#/$defs/OsmRenderRules"
        },
        "selection": {
          "$ref": "#/$defs/OsmSelection"
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/OsmSnapshotMetadata"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "OsmSettings",
      "type": "object"
    },
    "OsmSnapshotMetadata": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "default": "\u00a9 OpenStreetMap contributors",
          "title": "Attribution",
          "type": "string"
        },
        "bounds": {
          "$ref": "#/$defs/OsmBounds"
        },
        "byte_count": {
          "exclusiveMinimum": 0,
          "title": "Byte Count",
          "type": "integer"
        },
        "element_count": {
          "minimum": 0,
          "title": "Element Count",
          "type": "integer"
        },
        "fetched_at": {
          "title": "Fetched At",
          "type": "string"
        },
        "provider": {
          "default": "OpenStreetMap Overpass API",
          "title": "Provider",
          "type": "string"
        },
        "query_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Query Sha256",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "snapshot_id": {
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_date": {
          "title": "Source Date",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "sha256",
        "query_sha256",
        "fetched_at",
        "source_date",
        "element_count",
        "byte_count",
        "bounds"
      ],
      "title": "OsmSnapshotMetadata",
      "type": "object"
    },
    "PageSettings": {
      "additionalProperties": false,
      "properties": {
        "height_mm": {
          "default": 297.0,
          "exclusiveMinimum": 0,
          "title": "Height Mm",
          "type": "number"
        },
        "margin_mm": {
          "default": 10.0,
          "minimum": 0,
          "title": "Margin Mm",
          "type": "number"
        },
        "orientation": {
          "default": "landscape",
          "enum": [
            "landscape",
            "portrait"
