          "default": 3.0,
          "maximum": 8,
          "minimum": 1,
          "title": "Sampling Pixels Per Pen Width",
          "type": "number"
        },
        "scale_percent": {
          "default": 100.0,
          "exclusiveMinimum": 0,
          "maximum": 400,
          "title": "Scale Percent",
          "type": "number"
        },
        "sharpen_amount": {
          "default": 0.0,
          "maximum": 5,
          "minimum": 0,
          "title": "Sharpen Amount",
          "type": "number"
        },
        "threshold": {
          "default": 128,
          "maximum": 255,
          "minimum": 0,
          "title": "Threshold",
          "type": "integer"
        },
        "threshold_mode": {
          "default": "none",
          "enum": [
            "none",
            "global",
            "adaptive"
          ],
          "title": "Threshold Mode",
          "type": "string"
        }
      },
      "title": "RasterPreprocessSettings",
      "type": "object"
