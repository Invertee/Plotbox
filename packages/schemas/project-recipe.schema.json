          "title": "Pen Down Override"
        },
        "pen_id": {
          "title": "Pen Id",
          "type": "string"
        },
        "tip_width_mm": {
          "exclusiveMinimum": 0,
          "title": "Tip Width Mm",
          "type": "number"
        },
        "x_offset_mm": {
          "default": 0,
          "title": "X Offset Mm",
          "type": "number"
        },
        "y_offset_mm": {
          "default": 0,
          "title": "Y Offset Mm",
          "type": "number"
        }
      },
      "required": [
        "pen_id",
        "name",
        "display_color",
        "tip_width_mm"
      ],
      "title": "PenProfile",
      "type": "object"
