          "type": "number"
        },
        "crosshatch_thresholds": {
          "default": [
            210,
            160,
            110,
            60
          ],
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Crosshatch Thresholds",
          "type": "array"
        },
        "dither_angle_degrees": {
          "default": 45.0,
          "maximum": 360,
          "minimum": -360,
          "title": "Dither Angle Degrees",
          "type": "number"
        },
        "dither_contrast": {
          "default": 1.0,
