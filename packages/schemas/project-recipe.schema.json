          "type": "number"
        },
        "dither_gamma": {
          "default": 1.0,
          "maximum": 5,
          "minimum": 0.1,
          "title": "Dither Gamma",
          "type": "number"
        },
        "dither_mark": {
          "default": "dots",
          "enum": [
            "dots",
            "crosses",
            "pen-dots"
          ],
          "title": "Dither Mark",
          "type": "string"
        },
        "dither_max_mark_size_mm": {
          "default": 1.8,
          "exclusiveMinimum": 0,
          "maximum": 25,
          "title": "Dither Max Mark Size Mm",
          "type": "number"
