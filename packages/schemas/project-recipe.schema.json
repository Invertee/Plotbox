      "additionalProperties": false,
      "description": "Physically meaningful controls shared by the raster-to-vector algorithms.",
      "properties": {
        "algorithm": {
          "default": "edge",
          "enum": [
            "edge",
            "centerline",
            "hatch",
            "crosshatch",
            "squiggle",
            "circular-scribble",
            "tone-contour",
            "color-outline",
            "color-hatch",
            "dither",
            "stipple"
          ],
          "title": "Algorithm",
          "type": "string"
        },
        "centerline_prune_length_mm": {
          "default": 1.5,
          "minimum": 0,
          "title": "Centerline Prune Length Mm",
          "type": "number"
        },
        "centerline_threshold": {
          "default": 160,
          "maximum": 255,
          "minimum": 0,
          "title": "Centerline Threshold",
          "type": "integer"
        },
        "color_background_threshold": {
          "default": 248,
          "maximum": 255,
          "minimum": 0,
          "title": "Color Background Threshold",
          "type": "integer"
        },
        "color_count": {
          "default": 2,
          "maximum": 8,
          "minimum": 2,
          "title": "Color Count",
          "type": "integer"
        },
        "contour_levels": {
          "default": 6,
          "maximum": 32,
          "minimum": 1,
