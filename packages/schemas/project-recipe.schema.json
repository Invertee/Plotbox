          "type": "number"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "pass_id": {
          "title": "Pass Id",
          "type": "string"
        },
        "pen_down_override": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pen Down Override"
        },
        "pen_profile_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pen Profile Id"
        },
        "preview_color": {
          "title": "Preview Color",
          "type": "string"
        },
        "semantic_role": {
          "title": "Semantic Role",
          "type": "string"
        },
        "source_layer_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Layer Ids",
          "type": "array"
        },
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        }
      },
      "required": [
        "pass_id",
        "name",
        "semantic_role",
        "preview_color"
