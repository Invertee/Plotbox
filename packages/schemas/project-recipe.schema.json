      "title": "PassSettings",
      "type": "object"
    },
    "PenProfile": {
      "additionalProperties": false,
      "properties": {
        "display_color": {
          "title": "Display Color",
          "type": "string"
        },
        "draw_feed_mm_min": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Draw Feed Mm Min"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "pen_down_override": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
