    "RasterPreprocessSettings": {
      "additionalProperties": false,
      "properties": {
        "adaptive_offset": {
          "default": 5,
          "maximum": 64,
          "minimum": -64,
          "title": "Adaptive Offset",
          "type": "integer"
        },
        "adaptive_window_px": {
          "default": 15,
          "maximum": 101,
          "minimum": 3,
          "title": "Adaptive Window Px",
          "type": "integer"
        },
        "blur_radius_px": {
          "default": 0.0,
          "maximum": 20,
          "minimum": 0,
          "title": "Blur Radius Px",
          "type": "number"
        },
        "channel": {
          "default": "luminance",
          "enum": [
            "luminance",
            "red",
            "green",
            "blue"
