            "contain",
            "cover",
            "stretch"
          ],
          "title": "Fit Mode",
          "type": "string"
        },
        "gamma": {
          "default": 1.0,
          "maximum": 5,
          "minimum": 0.1,
          "title": "Gamma",
          "type": "number"
        },
        "invert": {
          "default": false,
          "title": "Invert",
          "type": "boolean"
        },
        "maximum_megapixels": {
          "default": 8.0,
          "maximum": 25,
          "minimum": 0.1,
          "title": "Maximum Megapixels",
          "type": "number"
        },
        "morphology": {
          "default": "none",
          "enum": [
            "none",
            "open",
            "close"
          ],
          "title": "Morphology",
          "type": "string"
        },
        "morphology_radius_px": {
          "default": 0,
          "maximum": 5,
          "minimum": 0,
          "title": "Morphology Radius Px",
          "type": "integer"
        },
        "rotation_degrees": {
          "default": 0,
          "enum": [
            0,
            90,
            180,
            270
