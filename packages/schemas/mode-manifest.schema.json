{
  "$defs": {
    "ComplexityEstimate": {
      "additionalProperties": false,
      "properties": {
        "paths": {
          "minimum": 0,
          "title": "Paths",
          "type": "integer"
        },
        "relative_work": {
          "minimum": 0,
          "title": "Relative Work",
          "type": "number"
        },
        "vertices": {
          "minimum": 0,
          "title": "Vertices",
          "type": "integer"
        }
      },
      "required": [
        "paths",
        "vertices",
        "relative_work"
      ],
      "title": "ComplexityEstimate",
      "type": "object"
    },
    "ModeParameter": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "$ref": "#/$defs/ModeParameterValue"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "group": {
          "pattern": "^[a-z][a-z0-9-]*$",
          "title": "Group",
          "type": "string"
        },
        "key": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "number",
            "integer",
            "boolean",
            "enum",
            "seed",
            "color",
            "role",
            "range"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/ModeParameterOption"
          },
          "title": "Options",
          "type": "array"
        },
        "step": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label",
        "kind",
        "group",
        "default"
      ],
      "title": "ModeParameter",
      "type": "object"
    },
    "ModeParameterGroup": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "group_id": {
          "pattern": "^[a-z][a-z0-9-]*$",
          "title": "Group Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "group_id",
        "label"
      ],
      "title": "ModeParameterGroup",
      "type": "object"
    },
    "ModeParameterOption": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "title": "ModeParameterOption",
      "type": "object"
    },
    "ModeParameterValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "type": "number"
          },
          "type": "array"
        }
      ]
    },
    "ModePreset": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "mode_id": {
          "pattern": "^[a-z][a-z0-9.-]*$",
          "title": "Mode Id",
          "type": "string"
        },
        "mode_version": {
          "minLength": 1,
          "title": "Mode Version",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parameter_schema_version": {
          "minimum": 1,
          "title": "Parameter Schema Version",
          "type": "integer"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/ModeParameterValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "preset_id": {
          "pattern": "^[a-z][a-z0-9-]*$",
          "title": "Preset Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "seed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "preset_id",
        "version",
        "mode_id",
        "mode_version",
        "name",
        "parameter_schema_version"
      ],
      "title": "ModePreset",
      "type": "object"
    },
    "QualityLevel": {
      "enum": [
        "draft",
        "standard",
        "export"
      ],
      "title": "QualityLevel",
      "type": "string"
    },
    "QualityMapping": {
      "additionalProperties": false,
      "properties": {
        "density_scale": {
          "exclusiveMinimum": 0,
          "title": "Density Scale",
          "type": "number"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "sampling_scale": {
          "exclusiveMinimum": 0,
          "title": "Sampling Scale",
          "type": "number"
        }
      },
      "required": [
        "density_scale",
        "sampling_scale",
        "label"
      ],
      "title": "QualityMapping",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "algorithms": {
      "items": {
        "type": "string"
      },
      "title": "Algorithms",
      "type": "array"
    },
    "category": {
      "default": "procedural",
      "title": "Category",
      "type": "string"
    },
    "default_complexity": {
      "anyOf": [
        {
          "$ref": "#/$defs/ComplexityEstimate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9.-]*$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "default": "generator",
      "enum": [
        "generator",
        "importer"
      ],
      "title": "Kind",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "parameter_groups": {
      "items": {
        "$ref": "#/$defs/ModeParameterGroup"
      },
      "title": "Parameter Groups",
      "type": "array"
    },
    "parameter_schema": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parameter Schema"
    },
    "parameter_schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Parameter Schema Version",
      "type": "integer"
    },
    "parameters": {
      "items": {
        "$ref": "#/$defs/ModeParameter"
      },
      "title": "Parameters",
      "type": "array"
    },
    "presets": {
      "items": {
        "$ref": "#/$defs/ModePreset"
      },
      "title": "Presets",
      "type": "array"
    },
    "quality_levels": {
      "items": {
        "$ref": "#/$defs/QualityLevel"
      },
      "minItems": 1,
      "title": "Quality Levels",
      "type": "array"
    },
    "quality_mappings": {
      "additionalProperties": {
        "$ref": "#/$defs/QualityMapping"
      },
      "propertyNames": {
        "$ref": "#/$defs/QualityLevel"
      },
      "title": "Quality Mappings",
      "type": "object"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "semantic_roles": {
      "items": {
        "type": "string"
      },
      "title": "Semantic Roles",
      "type": "array"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "name",
    "quality_levels"
  ],
  "title": "ModeManifest",
  "type": "object"
}
