      "$ref": "#/$defs/RasterPlacement"
    },
    "preview_png_base64": {
      "title": "Preview Png Base64",
      "type": "string"
    },
    "preview_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Preview Sha256",
      "type": "string"
    },
    "processed_height_px": {
      "exclusiveMinimum": 0,
      "title": "Processed Height Px",
      "type": "integer"
    },
    "processed_width_px": {
      "exclusiveMinimum": 0,
      "title": "Processed Width Px",
      "type": "integer"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_asset_sha256": {
      "title": "Source Asset Sha256",
      "type": "string"
    },
    "source_height_px": {
      "exclusiveMinimum": 0,
      "title": "Source Height Px",
      "type": "integer"
    },
    "source_width_px": {
      "exclusiveMinimum": 0,
