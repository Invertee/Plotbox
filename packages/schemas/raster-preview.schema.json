        "height_mm": {
          "exclusiveMinimum": 0,
          "title": "Height Mm",
          "type": "number"
        },
        "width_mm": {
          "exclusiveMinimum": 0,
          "title": "Width Mm",
          "type": "number"
        },
        "x_mm": {
          "title": "X Mm",
          "type": "number"
        },
        "y_mm": {
          "title": "Y Mm",
          "type": "number"
        }
      },
      "required": [
        "x_mm",
        "y_mm",
        "width_mm",
        "height_mm"
      ],
      "title": "RasterPlacement",
      "type": "object"
    },
    "RasterPreviewWarning": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "RasterPreviewWarning",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "crop_box_px": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "title": "Crop Box Px",
      "type": "array"
    },
    "frame_count": {
      "default": 1,
      "minimum": 1,
      "title": "Frame Count",
      "type": "integer"
    },
    "mm_per_pixel_x": {
      "exclusiveMinimum": 0,
      "title": "Mm Per Pixel X",
      "type": "number"
    },
    "mm_per_pixel_y": {
      "exclusiveMinimum": 0,
      "title": "Mm Per Pixel Y",
      "type": "number"
    },
    "pen_width_mm": {
      "exclusiveMinimum": 0,
      "title": "Pen Width Mm",
      "type": "number"
    },
